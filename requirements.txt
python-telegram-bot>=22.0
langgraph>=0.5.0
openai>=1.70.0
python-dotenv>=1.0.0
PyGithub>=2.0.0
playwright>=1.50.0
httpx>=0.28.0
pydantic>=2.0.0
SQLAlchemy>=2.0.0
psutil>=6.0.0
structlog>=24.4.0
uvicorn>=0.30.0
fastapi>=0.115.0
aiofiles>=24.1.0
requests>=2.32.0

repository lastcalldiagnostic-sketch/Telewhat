from __future__ import annotations

import os

from app.config import Config
from app.database import init_db
from app.logger import logger


def main() -> None:
    from dotenv import load_dotenv

    load_dotenv()
    os.makedirs(Config.DEFAULT_WORKSPACE, exist_ok=True)
    os.makedirs("logs", exist_ok=True)
    init_db()

    if not Config.TELEGRAM_TOKEN:
        logger.warning("TELEGRAM_TOKEN is not set. The bot will not start until it is configured.")

    from app.telegram.handlers import build_application

    app = build_application()
    logger.info("Starting Telewhat Telegram bot")
    app.run_polling()


if __name__ == "__main__":
    main()
